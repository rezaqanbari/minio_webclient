@model List<minio_csharpClient.Models.BucketViewModel>
@{
    ViewData["Title"] = "داشبورد مدیریت MinIO";
    bool isOnline = ViewBag.IsOnline ?? false;
    string endpoint = ViewBag.Endpoint ?? "";
    bool withSsl = ViewBag.WithSSL ?? true;
    string? errorMessage = ViewBag.ErrorMessage;
}

<div class="row g-4 mb-4">
    <!-- Server Status Card -->
    <div class="col-md-4">
        <div class="card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small">وضعیت سرور</span>
                @if (isOnline)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle badge-status">
                        <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> آنلاین و متصل
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle badge-status">
                        <i class="bi bi-x-circle-fill me-1"></i> قطع ارتباط
                    </span>
                }
            </div>
            <h5 class="fw-bold mb-1 font-monospace">@endpoint</h5>
            <div class="text-muted small mt-2">
                <i class="bi bi-lock-fill text-success"></i> پروتکل: @(withSsl ? "HTTPS (SSL فعال)" : "HTTP")
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="text-danger small mt-2">
                    <i class="bi bi-exclamation-circle"></i> @errorMessage
                </div>
            }
        </div>
    </div>

    <!-- Buckets Count Card -->
    <div class="col-md-4">
        <div class="card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small">تعداد کل باکت‌ها</span>
                <i class="bi bi-archive-fill text-primary fs-4"></i>
            </div>
            <h2 class="fw-bold mb-0 text-primary">@Model.Count</h2>
            <div class="text-muted small mt-2">
                باکت‌های موجود در این سرور
            </div>
        </div>
    </div>

    <!-- Quick Actions Card -->
    <div class="col-md-4">
        <div class="card h-100 p-3 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small">عملیات سریع</span>
                    <i class="bi bi-lightning-charge-fill text-warning fs-4"></i>
                </div>
                <div class="small text-muted mb-3">ایجاد فوری باکت ذخیره‌سازی داده جدید</div>
            </div>
            <button type="button" class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100" data-bs-toggle="modal" data-bs-target="#createBucketModal">
                <i class="bi bi-plus-circle-fill"></i> ایجاد باکت جدید
            </button>
        </div>
    </div>
</div>

<!-- Buckets List Table -->
<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
            <i class="bi bi-folder-fill text-warning"></i> لیست باکت‌های ذخیره‌سازی (Buckets)
        </h5>
        <div class="d-flex gap-2">
            <a asp-controller="Buckets" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-repeat"></i> رفرش لیست
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="py-3 px-4">#</th>
                    <th scope="col" class="py-3">نام باکت (Bucket Name)</th>
                    <th scope="col" class="py-3">تاریخ ایجاد</th>
                    <th scope="col" class="py-3 text-center">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            هنوز باکتی ایجاد نشده است یا دسترسی به سرور وجود ندارد.
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    foreach (var bucket in Model)
                    {
                        <tr>
                            <td class="px-4 text-muted small">@index</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-bucket-fill text-primary fs-5"></i>
                                    <a asp-controller="Objects" asp-action="Index" asp-route-bucketName="@bucket.Name" class="fw-bold text-decoration-none text-dark hover-primary font-monospace">
                                        @bucket.Name
                                    </a>
                                </div>
                            </td>
                            <td class="text-muted small font-monospace">
                                @bucket.FormattedCreationDate
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-controller="Objects" asp-action="Index" asp-route-bucketName="@bucket.Name" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-folder2-open"></i> مرور فایل‌ها
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteBucket('@bucket.Name')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create Bucket -->
<div class="modal fade" id="createBucketModal" tabindex="-1" aria-labelledby="createBucketModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Buckets" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createBucketModalLabel">
                        <i class="bi bi-folder-plus text-primary"></i> ایجاد باکت جدید
                    </h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="bucketNameInput" class="form-label">نام باکت (Bucket Name)</label>
                        <input type="text" class="form-control font-monospace" id="bucketNameInput" name="BucketName" placeholder="مثال: my-vod-media" required autofocus>
                        <div class="form-text small">
                            قوانین نام‌گذاری: فقط حروف کوچک انگلیسی، اعداد و خط تیره (-) بدون فاصله مجاز است (بین ۳ تا ۶۳ کاراکتر).
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-1">
                        <i class="bi bi-check-lg"></i> ایجاد باکت
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hidden Form for Delete Bucket -->
<form id="deleteBucketForm" asp-controller="Buckets" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bucketName" id="deleteBucketNameInput" />
</form>

@section Scripts {
    <script>
        function confirmDeleteBucket(bucketName) {
            Swal.fire({
                title: 'آیا از حذف باکت مطمئن هستید؟',
                text: `باکت "${bucketName}" حذف خواهد شد. توجه داشته باشید باکت باید خالی از هرگونه فایل باشد.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteBucketNameInput').value = bucketName;
                    document.getElementById('deleteBucketForm').submit();
                }
            });
        }
    </script>
}
