<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت MinIO</title>
    <!-- Google Fonts: Vazirmatn -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 RTL & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        body {
            font-family: 'Vazirmatn', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .card {
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.05);
            transition: all 0.2s ease-in-out;
        }
        .card:hover {
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
        .badge-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }
        .table-hover tbody tr:hover {
            background-color: #f1f5f9;
        }
        .btn-action {
            padding: 4px 8px;
            font-size: 0.875rem;
            border-radius: 6px;
        }
        .cursor-pointer {
            cursor: pointer;
        }
        .font-monospace {
            font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
            direction: ltr;
            text-align: left;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3 mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 text-white" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam-fill text-danger fs-4"></i>
                    <span>مدیریت MinIO</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link text-white-50 active d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> داشبورد
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50 d-flex align-items-center gap-1" asp-controller="Buckets" asp-action="Index">
                                    <i class="bi bi-archive-fill"></i> مدیریت باکت‌ها
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0"></ul>
                    }
@inject Microsoft.Extensions.Options.IOptions<minio_csharpClient.Models.MinioOptions> MinioOptionsAccessor
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-white-50 small font-monospace d-none d-md-inline">
                            <i class="bi bi-link-45deg"></i> @MinioOptionsAccessor.Value.Endpoint
                        </span>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-shield-check"></i> SSL امن
                        </span>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="badge bg-secondary bg-opacity-50 text-white font-monospace px-3 py-2 rounded-pill">
                                <i class="bi bi-person-fill"></i> @User.Identity.Name
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1" title="خروج از حساب">
                                    <i class="bi bi-box-arrow-left"></i> خروج
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mb-5">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@Html.Raw(TempData["Success"])</div>
                <button type="button" class="btn-close ms-auto me-0" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@Html.Raw(TempData["Error"])</div>
                <button type="button" class="btn-close ms-auto me-0" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-white border-top text-muted">
        <div class="container text-center small">
            <span>سامانه وب مدیریت آبجکت‌های MinIO &bull; توسعه داده شده با ASP.NET Core 9</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
