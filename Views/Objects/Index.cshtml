@model minio_csharpClient.Models.BucketContentViewModel
@{
    ViewData["Title"] = $"کاوشگر فایل: {Model.BucketName}";
}

<!-- Top Header with Actions -->
<div class="card mb-3">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Buckets" asp-action="Index" class="btn btn-outline-secondary btn-sm" title="بازگشت به باکت‌ها">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2 font-monospace">
                        <i class="bi bi-bucket-fill text-primary"></i> @Model.BucketName
                    </h5>
                </div>
                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb" class="mt-2">
                    <ol class="breadcrumb mb-0 small">
                        @for (int i = 0; i < Model.Breadcrumbs.Count; i++)
                        {
                            var b = Model.Breadcrumbs[i];
                            if (b.IsActive)
                            {
                                <li class="breadcrumb-item active font-monospace" aria-current="page">@b.Title</li>
                            }
                            else
                            {
                                <li class="breadcrumb-item font-monospace">
                                    <a asp-action="Index" asp-route-bucketName="@Model.BucketName" asp-route-prefix="@b.Prefix">@b.Title</a>
                                </li>
                            }
                        }
                    </ol>
                </nav>
            </div>

            <!-- Action buttons -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createFolderModal">
                    <i class="bi bi-folder-plus text-warning"></i> پوشه جدید
                </button>
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <i class="bi bi-cloud-arrow-up-fill"></i> آپلود فایل
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Search and Info Bar -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="fileSearchInput" class="form-control border-start-0 font-monospace" placeholder="جستجوی فایل یا پوشه...">
        </div>
    </div>
    <div class="col-md-6 d-flex justify-content-md-end align-items-center gap-3 text-muted small">
        <span><i class="bi bi-folder"></i> پوشه‌ها: <strong>@Model.TotalDirectories</strong></span>
        <span><i class="bi bi-file-earmark"></i> فایل‌ها: <strong>@Model.TotalFiles</strong></span>
        <span><i class="bi bi-hdd"></i> حجم فایل‌ها: <strong>@Model.FormattedTotalFilesSize</strong></span>
    </div>
</div>

<!-- Objects Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="objectsTable">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="py-3 px-3" style="width: 45px;"></th>
                    <th scope="col" class="py-3">نام فایل / پوشه</th>
                    <th scope="col" class="py-3" style="width: 120px;">حجم</th>
                    <th scope="col" class="py-3" style="width: 180px;">آخرین تغییرات</th>
                    <th scope="col" class="py-3 text-center" style="width: 220px;">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ParentPrefix != null)
                {
                    <tr>
                        <td class="text-center px-3"><i class="bi bi-arrow-90deg-up text-secondary"></i></td>
                        <td colspan="4">
                            <a asp-action="Index" asp-route-bucketName="@Model.BucketName" asp-route-prefix="@Model.ParentPrefix" class="text-decoration-none fw-bold text-secondary">
                                .. (بازگشت به پوشه بالاتر)
                            </a>
                        </td>
                    </tr>
                }

                @if (Model.Items == null || Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-folder2-open fs-1 d-block mb-2 text-secondary"></i>
                            این پوشه خالی است. می‌توانید فایلی آپلود کرده یا پوشه جدیدی بسازید.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="item-row">
                            <td class="text-center px-3">
                                <i class="bi @item.IconClass fs-5"></i>
                            </td>
                            <td>
                                @if (item.IsDir)
                                {
                                    <a asp-action="Index" asp-route-bucketName="@Model.BucketName" asp-route-prefix="@item.Key" class="fw-bold text-dark text-decoration-none hover-primary font-monospace item-name">
                                        @item.DisplayName
                                    </a>
                                }
                                else
                                {
                                    <span class="font-monospace item-name text-break">@item.DisplayName</span>
                                }
                            </td>
                            <td class="text-muted small font-monospace">@item.FormattedSize</td>
                            <td class="text-muted small font-monospace">@item.FormattedLastModified</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (!item.IsDir)
                                    {
                                        @if (item.IsPreviewable)
                                        {
                                            <button type="button" class="btn btn-outline-info" title="پیش‌نمایش" onclick="previewObject('@item.BucketName', '@item.Key', '@item.PreviewType', '@item.DisplayName')">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-success" title="لینک اشتراک‌گذاری موقت (Presigned URL)" onclick="openPresignedModal('@item.BucketName', '@item.Key')">
                                            <i class="bi bi-link-45deg"></i>
                                        </button>
                                        <a asp-action="Download" asp-route-bucketName="@item.BucketName" asp-route-key="@item.Key" class="btn btn-outline-primary" title="دانلود فایل">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" title="حذف فایل" onclick="confirmDeleteFile('@item.BucketName', '@item.Key')">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="Index" asp-route-bucketName="@Model.BucketName" asp-route-prefix="@item.Key" class="btn btn-outline-secondary" title="ورود به پوشه">
                                            <i class="bi bi-box-arrow-in-left"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" title="حذف کامل پوشه" onclick="confirmDeleteFolder('@item.BucketName', '@item.Key')">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Upload File -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="uploadModalLabel">
                    <i class="bi bi-cloud-arrow-up text-primary"></i> آپلود فایل در باکت
                </h5>
                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن" id="closeUploadModalBtn"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 text-muted small d-flex align-items-center justify-content-between">
                    <div>مسیر ذخیره‌سازی: <strong class="font-monospace text-dark" dir="ltr">@(string.IsNullOrEmpty(Model.CurrentPrefix) ? "/" : "/" + Model.CurrentPrefix)</strong></div>
                    <span class="badge bg-light text-muted border">حداکثر ۵۰۰ مگابایت برای هر فایل</span>
                </div>

                <div class="border border-2 border-dashed rounded-3 p-4 text-center bg-light cursor-pointer" id="dropZone" onclick="document.getElementById('fileInput').click()">
                    <i class="bi bi-cloud-arrow-up-fill text-primary display-4 d-block mb-2"></i>
                    <h6 class="fw-bold mb-1">فایل‌ها را اینجا بکشید یا برای انتخاب کلیک کنید</h6>
                    <span class="text-muted small">امکان انتخاب و بارگذاری همزمان چندین فایل</span>
                    <input type="file" id="fileInput" class="d-none" multiple />
                </div>

                <!-- Overall Progress Container -->
                <div id="overallProgressContainer" class="d-none mt-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-dark d-flex align-items-center gap-1">
                            <i class="bi bi-activity text-primary"></i> پیشرفت کل عملیات بارگذاری
                        </span>
                        <span class="small font-monospace text-primary fw-bold" id="overallProgressText">0 / 0 فایل</span>
                    </div>
                    <div class="progress" style="height: 12px;">
                        <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="overallProgressBar" role="progressbar" style="width: 0%;"></div>
                    </div>
                </div>

                <!-- Per-file progress list -->
                <div id="selectedFilesList" class="mt-3" style="max-height: 280px; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" id="cancelUploadModalBtn">انصراف</button>
                <button type="button" class="btn btn-primary d-flex align-items-center gap-2" id="startUploadBtn" disabled onclick="startChunkedUpload()">
                    <i class="bi bi-upload"></i> شروع آپلود فایل‌ها
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Create Folder -->
<div class="modal fade" id="createFolderModal" tabindex="-1" aria-labelledby="createFolderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateFolder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BucketName" value="@Model.BucketName" />
                <input type="hidden" name="CurrentPrefix" value="@Model.CurrentPrefix" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createFolderModalLabel">
                        <i class="bi bi-folder-plus text-warning"></i> ایجاد پوشه جدید
                    </h5>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="folderNameInput" class="form-label">نام پوشه</label>
                        <input type="text" class="form-control font-monospace" id="folderNameInput" name="FolderName" placeholder="مثال: videos" required autofocus>
                        <div class="form-text small">نام پوشه به انتهای مسیر جاری اضافه خواهد شد.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary">ایجاد پوشه</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Presigned URL -->
<div class="modal fade" id="presignedModal" tabindex="-1" aria-labelledby="presignedModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="presignedModalLabel">
                    <i class="bi bi-link-45deg text-success"></i> لینک موقت اشتراک‌گذاری
                </h5>
                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="presignedBucket" />
                <input type="hidden" id="presignedObject" />

                <div class="mb-3">
                    <label class="form-label">مدت زمان اعتبار لینک:</label>
                    <select id="presignedExpiry" class="form-select">
                        <option value="1">۱ ساعت</option>
                        <option value="6">۶ ساعت</option>
                        <option value="24" selected>۲۴ ساعت (یک روز)</option>
                        <option value="72">۳ روز</option>
                        <option value="168">۷ روز (حداکثر)</option>
                    </select>
                </div>

                <div class="d-grid mb-3">
                    <button type="button" class="btn btn-outline-primary" id="btnGeneratePresigned" onclick="generatePresignedUrl()">
                        <i class="bi bi-arrow-clockwise"></i> تولید لینک امن
                    </button>
                </div>

                <div id="presignedResultArea" class="d-none">
                    <label class="form-label small text-muted">آدرس لینک تولید شده:</label>
                    <div class="input-group mb-2">
                        <input type="text" id="presignedUrlOutput" class="form-control font-monospace small" readonly />
                        <button class="btn btn-secondary" type="button" onclick="copyPresignedUrl()" title="کپی لینک">
                            <i class="bi bi-clipboard"></i> کپی
                        </button>
                    </div>
                    <div class="d-flex justify-content-end">
                        <a id="presignedOpenBtn" href="#" target="_blank" class="btn btn-sm btn-link text-decoration-none">
                            <i class="bi bi-box-arrow-up-left"></i> باز کردن در برگه جدید
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Media & Text Preview -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-monospace small" id="previewModalLabel">پیش‌نمایش فایل</h5>
                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body p-0 text-center bg-dark text-white d-flex align-items-center justify-content-center" style="min-height: 400px; max-height: 80vh; overflow: auto;" id="previewContainer">
                <!-- Injected via JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- Hidden Delete Forms -->
<form id="deleteFileForm" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bucketName" value="@Model.BucketName" />
    <input type="hidden" name="prefix" value="@Model.CurrentPrefix" />
    <input type="hidden" name="key" id="deleteFileKeyInput" />
</form>

<form id="deleteFolderForm" asp-action="DeleteFolder" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bucketName" value="@Model.BucketName" />
    <input type="hidden" name="prefix" value="@Model.CurrentPrefix" />
    <input type="hidden" name="folderPrefix" id="deleteFolderPrefixInput" />
</form>

@section Scripts {
    <script>
        // Realtime filter items
        document.getElementById('fileSearchInput')?.addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('.item-row');
            rows.forEach(row => {
                const name = row.querySelector('.item-name')?.textContent.toLowerCase() || '';
                if (name.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // File upload drag & drop and real-time progress upload
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const selectedFilesList = document.getElementById('selectedFilesList');
        const startUploadBtn = document.getElementById('startUploadBtn');
        const cancelUploadModalBtn = document.getElementById('cancelUploadModalBtn');
        const closeUploadModalBtn = document.getElementById('closeUploadModalBtn');
        const overallProgressContainer = document.getElementById('overallProgressContainer');
        const overallProgressBar = document.getElementById('overallProgressBar');
        const overallProgressText = document.getElementById('overallProgressText');

        let selectedFiles = [];
        let isUploading = false;

        if (dropZone && fileInput) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (!isUploading) {
                        dropZone.classList.add('border-primary', 'bg-white');
                    }
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.remove('border-primary', 'bg-white');
                }, false);
            });

            dropZone.addEventListener('drop', (e) => {
                if (isUploading) return;
                const dt = e.dataTransfer;
                if (dt.files && dt.files.length > 0) {
                    fileInput.files = dt.files;
                    renderFileList();
                }
            });

            fileInput.addEventListener('change', renderFileList);
        }

        function formatBytes(bytes, decimals = 1) {
            if (!bytes || bytes === 0) return '0 B';
            const k = 1024;
            const dm = decimals < 0 ? 0 : decimals;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
        }

        function renderFileList() {
            selectedFiles = Array.from(fileInput.files || []);
            selectedFilesList.innerHTML = '';
            overallProgressContainer.classList.add('d-none');
            overallProgressBar.style.width = '0%';
            overallProgressBar.className = 'progress-bar bg-success progress-bar-striped progress-bar-animated';
            overallProgressText.textContent = `0 / ${selectedFiles.length} فایل`;

            if (selectedFiles.length > 0) {
                startUploadBtn.disabled = false;
                let listHtml = '<div class="list-group gap-2">';
                selectedFiles.forEach((file, idx) => {
                    listHtml += `
                    <div class="list-group-item border rounded p-2 shadow-sm" id="file-row-${idx}">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 60%;">
                                <i class="bi bi-file-earmark-arrow-up text-primary fs-5"></i>
                                <span class="font-monospace fw-bold text-dark text-truncate" title="${escapeHtml(file.name)}">${escapeHtml(file.name)}</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small font-monospace text-muted" id="file-speed-${idx}"></span>
                                <span class="badge bg-secondary font-monospace" id="file-status-${idx}">در صف انتظار</span>
                            </div>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="file-progress-${idx}" role="progressbar" style="width: 0%;"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="font-monospace text-muted small" id="file-bytes-${idx}">0 B / ${formatBytes(file.size)}</span>
                            <span class="font-monospace fw-bold text-primary small" id="file-percent-${idx}">0%</span>
                        </div>
                    </div>`;
                });
                listHtml += '</div>';
                selectedFilesList.innerHTML = listHtml;
            } else {
                startUploadBtn.disabled = true;
            }
        }

        async function startChunkedUpload() {
            if (isUploading || !selectedFiles || selectedFiles.length === 0) return;
            isUploading = true;

            startUploadBtn.disabled = true;
            cancelUploadModalBtn.disabled = true;
            closeUploadModalBtn.disabled = true;
            dropZone.style.pointerEvents = 'none';
            dropZone.classList.add('opacity-50');

            overallProgressContainer.classList.remove('d-none');
            const totalFiles = selectedFiles.length;
            let completedCount = 0;
            let errorCount = 0;

            const bucketName = '@Model.BucketName';
            const currentPrefix = '@Model.CurrentPrefix';

            for (let i = 0; i < totalFiles; i++) {
                const file = selectedFiles[i];
                const rowEl = document.getElementById(`file-row-${i}`);
                const statusBadge = document.getElementById(`file-status-${i}`);
                const progressBar = document.getElementById(`file-progress-${i}`);
                const bytesText = document.getElementById(`file-bytes-${i}`);
                const percentText = document.getElementById(`file-percent-${i}`);
                const speedText = document.getElementById(`file-speed-${i}`);

                statusBadge.className = 'badge bg-primary';
                statusBadge.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> درحال آپلود...';
                rowEl.classList.add('border-primary', 'bg-primary-subtle');
                rowEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

                try {
                    await uploadSingleFile(file, bucketName, currentPrefix, (loaded, total, speed) => {
                        const pct = Math.min(100, Math.round((loaded / total) * 100));
                        progressBar.style.width = pct + '%';
                        percentText.textContent = pct + '%';
                        bytesText.textContent = `${formatBytes(loaded)} / ${formatBytes(total)}`;
                        if (speed > 0) {
                            speedText.textContent = `${formatBytes(speed)}/s`;
                        }
                    });

                    completedCount++;
                    progressBar.style.width = '100%';
                    progressBar.className = 'progress-bar bg-success';
                    percentText.textContent = '100%';
                    percentText.className = 'font-monospace fw-bold text-success small';
                    bytesText.textContent = `${formatBytes(file.size)} / ${formatBytes(file.size)}`;
                    speedText.textContent = '';
                    statusBadge.className = 'badge bg-success';
                    statusBadge.innerHTML = '<i class="bi bi-check-circle"></i> بارگذاری شد';
                    rowEl.classList.remove('border-primary', 'bg-primary-subtle');
                    rowEl.classList.add('border-success-subtle');
                } catch (err) {
                    errorCount++;
                    progressBar.className = 'progress-bar bg-danger';
                    statusBadge.className = 'badge bg-danger';
                    statusBadge.innerHTML = '<i class="bi bi-x-circle"></i> خطا';
                    rowEl.classList.remove('border-primary', 'bg-primary-subtle');
                    rowEl.classList.add('border-danger-subtle');
                    speedText.textContent = err.message || 'خطا در ارسال';
                    speedText.className = 'small text-danger';
                }

                // Update overall progress
                const overallPct = Math.round(((i + 1) / totalFiles) * 100);
                overallProgressBar.style.width = overallPct + '%';
                overallProgressText.textContent = `${completedCount} از ${totalFiles} فایل`;
            }

            isUploading = false;
            cancelUploadModalBtn.disabled = false;
            closeUploadModalBtn.disabled = false;
            dropZone.style.pointerEvents = 'auto';
            dropZone.classList.remove('opacity-50');

            if (errorCount === 0) {
                Swal.fire({
                    icon: 'success',
                    title: 'عملیات با موفقیت انجام شد',
                    text: `تعداد ${completedCount} فایل با موفقیت در باکت بارگذاری شد.`,
                    timer: 1800,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'warning',
                    title: 'پایان بارگذاری با خطا',
                    text: `${completedCount} فایل با موفقیت آپلود شد، اما در آپلود ${errorCount} فایل خطایی رخ داد.`,
                    confirmButtonText: 'متوجه شدم'
                }).then(() => {
                    if (completedCount > 0) {
                        window.location.reload();
                    }
                });
            }
        }

        function uploadSingleFile(file, bucketName, prefix, onProgress) {
            return new Promise((resolve, reject) => {
                const xhr = new XMLHttpRequest();
                const formData = new FormData();
                formData.append('bucketName', bucketName);
                formData.append('prefix', prefix || '');
                formData.append('file', file);

                let lastTime = Date.now();
                let lastLoaded = 0;

                xhr.upload.addEventListener('progress', (e) => {
                    if (e.lengthComputable) {
                        const now = Date.now();
                        const timeDiff = (now - lastTime) / 1000;
                        let speed = 0;
                        if (timeDiff >= 0.25) {
                            speed = (e.loaded - lastLoaded) / timeDiff;
                            lastTime = now;
                            lastLoaded = e.loaded;
                        }
                        if (onProgress) {
                            onProgress(e.loaded, e.total, speed);
                        }
                    }
                });

                xhr.addEventListener('load', () => {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        try {
                            const res = JSON.parse(xhr.responseText);
                            if (res.success) {
                                resolve(res);
                            } else {
                                reject(new Error(res.message || 'خطا در بارگذاری'));
                            }
                        } catch (e) {
                            resolve({ success: true });
                        }
                    } else {
                        let msg = `خطای سرور: ${xhr.status}`;
                        if (xhr.status === 413) {
                            msg = 'خطای ۴۱۳ (حجم فایل بیش از حد مجاز Nginx است. مقدار client_max_body_size در سرور باید افزایش یابد)';
                        } else {
                            try {
                                const res = JSON.parse(xhr.responseText);
                                if (res.message) msg = res.message;
                            } catch {}
                        }
                        reportClientError('شکست در آپلود فایل', `آپلود '${file.name}' به باکت '${bucketName}' (${formatBytes(file.size)})`, msg, xhr.status);
                        reject(new Error(msg));
                    }
                });

                xhr.addEventListener('error', () => {
                    const msg = 'خطا در ارتباط شبکه با سرور (احتمال قطع اتصال یا مسدود شدن درخواست توسط Nginx/فایروال)';
                    reportClientError('خطای ارتباط شبکه در آپلود', `فایل '${file.name}' (${formatBytes(file.size)})`, msg, 0);
                    reject(new Error(msg));
                });

                xhr.addEventListener('abort', () => {
                    reject(new Error('عملیات لغو شد'));
                });

                xhr.open('POST', '/Objects/UploadSingle');
                xhr.send(formData);
            });
        }

        function reportClientError(action, details, errorMsg, statusCode) {
            try {
                fetch('/ActivityLogs/LogClientError', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: action,
                        category: 'File',
                        details: details,
                        errorMessage: errorMsg,
                        statusCode: statusCode
                    })
                });
            } catch (e) {}
        }

        // Delete File confirmation
        function confirmDeleteFile(bucketName, key) {
            Swal.fire({
                title: 'آیا از حذف فایل مطمئن هستید؟',
                text: `فایل "${key}" حذف خواهد شد و این عملیات غیرقابل بازگشت است.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteFileKeyInput').value = key;
                    document.getElementById('deleteFileForm').submit();
                }
            });
        }

        // Delete Folder confirmation
        function confirmDeleteFolder(bucketName, folderPrefix) {
            Swal.fire({
                title: 'آیا از حذف کامل پوشه مطمئن هستید؟',
                text: `پوشه "${folderPrefix}" و تمامی فایل‌های درون آن حذف خواهند شد.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'بله، همه را حذف کن',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteFolderPrefixInput').value = folderPrefix;
                    document.getElementById('deleteFolderForm').submit();
                }
            });
        }

        // Presigned URL
        function openPresignedModal(bucketName, key) {
            document.getElementById('presignedBucket').value = bucketName;
            document.getElementById('presignedObject').value = key;
            document.getElementById('presignedResultArea').classList.add('d-none');
            new bootstrap.Modal(document.getElementById('presignedModal')).show();
        }

        async function generatePresignedUrl() {
            const bucket = document.getElementById('presignedBucket').value;
            const key = document.getElementById('presignedObject').value;
            const hours = parseInt(document.getElementById('presignedExpiry').value) || 24;

            try {
                const response = await fetch('/Objects/GetPresignedUrl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ bucketName: bucket, objectName: key, expiryHours: hours })
                });

                const data = await response.json();
                if (data.success) {
                    document.getElementById('presignedUrlOutput').value = data.url;
                    document.getElementById('presignedOpenBtn').href = data.url;
                    document.getElementById('presignedResultArea').classList.remove('d-none');
                } else {
                    Swal.fire('خطا', data.message || 'خطا در تولید لینک', 'error');
                }
            } catch (err) {
                Swal.fire('خطا', err.message, 'error');
            }
        }

        function copyPresignedUrl() {
            const input = document.getElementById('presignedUrlOutput');
            input.select();
            navigator.clipboard.writeText(input.value).then(() => {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'لینک در کلیپ‌بورد کپی شد',
                    showConfirmButton: false,
                    timer: 2000
                });
            });
        }

        // Preview Object
        async function previewObject(bucketName, key, previewType, displayName) {
            const container = document.getElementById('previewContainer');
            document.getElementById('previewModalLabel').textContent = displayName;
            container.innerHTML = '<div class="p-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 small text-light">درحال بارگذاری...</div></div>';
            
            const modal = new bootstrap.Modal(document.getElementById('previewModal'));
            modal.show();

            const streamUrl = `/Objects/StreamMedia?bucketName=${encodeURIComponent(bucketName)}&key=${encodeURIComponent(key)}`;

            if (previewType === 'image') {
                container.innerHTML = `<img src="${streamUrl}" class="img-fluid p-2" style="max-height: 75vh; object-fit: contain;" alt="${displayName}">`;
            } else if (previewType === 'video') {
                container.innerHTML = `<video controls autoplay class="w-100" style="max-height: 75vh;"><source src="${streamUrl}">مرورگر شما از پخش ویدیو پشتیبانی نمی‌کند.</video>`;
            } else if (previewType === 'audio') {
                const downloadUrl = `/Objects/Download?bucketName=${encodeURIComponent(bucketName)}&key=${encodeURIComponent(key)}`;
                container.innerHTML = `
                    <div class="p-4 w-100 text-center" style="max-width: 600px;">
                        <div class="mb-4">
                            <div class="d-inline-flex p-4 rounded-circle bg-info bg-opacity-10 text-info mb-3">
                                <i class="bi bi-music-note-beamed display-3"></i>
                            </div>
                            <h5 class="fw-bold text-white text-break font-monospace">${escapeHtml(displayName)}</h5>
                        </div>
                        <audio id="activeAudioPlayer" controls autoplay preload="auto" class="w-100 shadow rounded-pill" style="outline: none;">
                            <source src="${streamUrl}">
                            مرورگر شما از پخش صوت پشتیبانی نمی‌کند.
                        </audio>
                        <div id="audioErrorNotice" class="alert alert-warning py-2 small mt-3 d-none">
                            <i class="bi bi-exclamation-triangle"></i> مرورگر قادر به دکود این فرمت صوتی نیست. می‌توانید آن را مستقیماً دانلود کنید.
                        </div>
                        <div class="mt-4">
                            <a href="${downloadUrl}" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1">
                                <i class="bi bi-download"></i> دانلود مستقیم فایل صوتی
                            </a>
                        </div>
                    </div>`;

                const audioEl = document.getElementById('activeAudioPlayer');
                if (audioEl) {
                    audioEl.onerror = function() {
                        document.getElementById('audioErrorNotice')?.classList.remove('d-none');
                    };
                }
            } else if (previewType === 'pdf') {
                container.innerHTML = `<iframe src="${streamUrl}" class="w-100" style="height: 75vh;" frameborder="0"></iframe>`;
            } else if (previewType === 'text') {
                try {
                    const res = await fetch(`/Objects/GetTextPreview?bucketName=${encodeURIComponent(bucketName)}&key=${encodeURIComponent(key)}`);
                    const data = await res.json();
                    if (data.success) {
                        container.innerHTML = `<pre class="text-start font-monospace text-light p-3 m-0 w-100" style="max-height: 75vh; overflow: auto; white-space: pre-wrap; font-size: 0.85rem;"><code>${escapeHtml(data.content)}</code></pre>`;
                    } else {
                        container.innerHTML = `<div class="p-4 text-danger">${data.message}</div>`;
                    }
                } catch (e) {
                    container.innerHTML = `<div class="p-4 text-danger">${e.message}</div>`;
                }
            }
        }

        // Stop media playback when modal is closed
        document.getElementById('previewModal')?.addEventListener('hidden.bs.modal', function () {
            const container = document.getElementById('previewContainer');
            if (container) {
                const mediaEls = container.querySelectorAll('audio, video');
                mediaEls.forEach(m => {
                    m.pause();
                    m.removeAttribute('src');
                    m.load();
                });
                container.innerHTML = '';
            }
        });

        function escapeHtml(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
}
