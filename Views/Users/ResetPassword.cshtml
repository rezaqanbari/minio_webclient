@model minio_csharpClient.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "تغییر رمز عبور کاربر";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-key-fill text-warning fs-4"></i>
                        <h5 class="fw-bold mb-0">تغییر رمز عبور کاربر</h5>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-right"></i> بازگشت
                    </a>
                </div>
            </div>

            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <div class="alert alert-info py-2 small mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle fs-5"></i>
                    <span>تغییر رمز عبور برای کاربر: <strong class="font-monospace">@Model.Username</strong></span>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Username" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-bold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control font-monospace" placeholder="حداقل ۶ کاراکتر" required />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-muted"></i></span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control font-monospace" placeholder="تکرار رمز عبور جدید" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">انصراف</a>
                        <button type="submit" class="btn btn-warning text-dark d-flex align-items-center gap-2 fw-bold">
                            <i class="bi bi-check-circle"></i> ذخیره رمز عبور جدید
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
