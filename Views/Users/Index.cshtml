@model List<minio_csharpClient.Models.UserItemViewModel>
@{
    ViewData["Title"] = "مدیریت کاربران و دسترسی‌ها";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-people-fill text-primary"></i> مدیریت کاربران و دسترسی‌ها
        </h4>
        <div class="text-muted small">تعریف کاربران، تعیین نقش‌ها، باکت‌ها و پوشه‌های مجاز و تغییر رمز عبور</div>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-person-plus-fill"></i> کاربر جدید
    </a>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="userSearchInput" class="form-control border-start-0" placeholder="جستجو بر اساس نام کاربری یا نقش...">
                </div>
            </div>
            <div class="col-md-6 text-md-end mt-2 mt-md-0 text-muted small">
                <span>تعداد کل کاربران: <strong class="text-dark">@Model.Count</strong></span>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="py-3 px-3" style="width: 50px;">#</th>
                    <th scope="col" class="py-3">نام کاربری</th>
                    <th scope="col" class="py-3">نقش</th>
                    <th scope="col" class="py-3">باکت مجاز</th>
                    <th scope="col" class="py-3">پوشه مجاز (Prefix)</th>
                    <th scope="col" class="py-3 text-center">وضعیت</th>
                    <th scope="col" class="py-3">تاریخ ثبت</th>
                    <th scope="col" class="py-3 text-center" style="width: 200px;">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                            هیچ کاربری یافت نشد.
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    foreach (var user in Model)
                    {
                        <tr class="user-row">
                            <td class="px-3 text-muted">@(index++)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle @(user.Role == "Admin" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-weight: bold;">
                                        @(user.Username.Length > 0 ? user.Username[..1].ToUpper() : "U")
                                    </div>
                                    <div>
                                        <div class="fw-bold font-monospace text-dark">@user.Username</div>
                                        @if (user.Username.Equals(User.Identity?.Name, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary small">شما</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-shield-lock me-1"></i> مدیر سیستم (Admin)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="bi bi-person me-1"></i> کاربر عادی (User)
                                    </span>
                                }
                            </td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="text-success small fw-bold">
                                        <i class="bi bi-check-all me-1"></i> تمام باکت‌ها
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(user.AllowedBucket))
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis font-monospace">
                                        <i class="bi bi-archive me-1"></i> @user.AllowedBucket
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">تعریف‌نشده</span>
                                }
                            </td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="text-success small fw-bold">
                                        <i class="bi bi-check-all me-1"></i> تمام پوشه‌ها
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(user.AllowedPrefix))
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis font-monospace" dir="ltr">
                                        <i class="bi bi-folder me-1"></i> @user.AllowedPrefix
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">کل باکت (ریشه)</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">غیرفعال</span>
                                }
                            </td>
                            <td class="small text-muted font-monospace" dir="ltr">
                                @user.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="ویرایش">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-warning text-dark" title="تغییر رمز عبور">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="حذف"
                                            onclick="confirmDeleteUser('@user.Id', '@user.Username')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<form id="deleteUserForm" method="post" asp-action="Delete" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.getElementById('userSearchInput')?.addEventListener('keyup', function () {
            const query = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('.user-row');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });

        function confirmDeleteUser(userId, username) {
            Swal.fire({
                title: 'حذف کاربر',
                html: `آیا از حذف کاربر <strong>${username}</strong> اطمینان دارید؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('deleteUserForm');
                    form.action = `/Users/Delete/${userId}`;
                    form.submit();
                }
            });
        }
    </script>
}
