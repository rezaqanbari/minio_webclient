@model minio_csharpClient.Models.ActivityLogIndexViewModel
@{
    ViewData["Title"] = "گزارش عملکرد کاربران و لاگ‌های سیستم";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-primary"></i> گزارش عملکرد کاربران و رویدادهای سیستم
        </h4>
        <span class="text-muted small">مشاهده، فیلتر و مانیتورینگ کلیه فعالیت‌ها، عملیات فایل‌ها، ورودها و خطاهای کاربران</span>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#clearLogsModal">
                <i class="bi bi-trash3"></i> پاک‌سازی لاگ‌های قدیمی
            </button>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
    </div>
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card p-3 border-0 shadow-sm h-100 bg-light">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small">کل فعالیت‌های امروز</span>
                <i class="bi bi-activity text-primary fs-4"></i>
            </div>
            <h3 class="fw-bold mb-0 text-dark font-monospace">@Model.Stats.TodayTotal</h3>
            <div class="text-muted small mt-1">تعداد رخداد ثبت‌شده</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3 border-0 shadow-sm h-100 bg-light">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small">خطاهای امروز</span>
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
            </div>
            <h3 class="fw-bold mb-0 @(Model.Stats.TodayErrors > 0 ? "text-danger" : "text-success") font-monospace">@Model.Stats.TodayErrors</h3>
            <div class="text-muted small mt-1">نیاز به بررسی و پیگیری</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3 border-0 shadow-sm h-100 bg-light">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small">آپلودهای امروز</span>
                <i class="bi bi-cloud-arrow-up-fill text-success fs-4"></i>
            </div>
            <h3 class="fw-bold mb-0 text-success font-monospace">@Model.Stats.TodayUploads</h3>
            <div class="text-muted small mt-1">فایل بارگذاری‌شده</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3 border-0 shadow-sm h-100 bg-light">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small">ورودهای امروز</span>
                <i class="bi bi-box-arrow-in-right text-info fs-4"></i>
            </div>
            <h3 class="fw-bold mb-0 text-info font-monospace">@Model.Stats.TodayLogins</h3>
            <div class="text-muted small mt-1">نشست‌های موفق کاربری</div>
        </div>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">جستجو در پیام و جزئیات</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control font-monospace" placeholder="نام فایل، خطا، IP..." value="@Model.SearchQuery" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">کاربر</label>
                <select name="username" class="form-select form-select-sm font-monospace">
                    <option value="">همه کاربران</option>
                    @foreach (var u in Model.Users)
                    {
                        if (u == Model.SelectedUser)
                        {
                            <option value="@u" selected>@u</option>
                        }
                        else
                        {
                            <option value="@u">@u</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">دسته‌بندی</label>
                <select name="category" class="form-select form-select-sm">
                    <option value="">همه دسته‌ها</option>
                    @foreach (var c in Model.Categories)
                    {
                        if (c == Model.SelectedCategory)
                        {
                            <option value="@c" selected>@c</option>
                        }
                        else
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">سطح رویداد</label>
                <select name="logLevel" class="form-select form-select-sm font-monospace">
                    <option value="">همه سطوح</option>
                    <option value="Info" selected="@(Model.SelectedLogLevel == "Info")">Info (عادی)</option>
                    <option value="Warning" selected="@(Model.SelectedLogLevel == "Warning")">Warning (هشدار)</option>
                    <option value="Error" selected="@(Model.SelectedLogLevel == "Error")">Error (خطا)</option>
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label small text-muted mb-1">وضعیت</label>
                <select name="isSuccess" class="form-select form-select-sm">
                    <option value="">همه</option>
                    <option value="true" selected="@(Model.SelectedIsSuccess == true)">موفق</option>
                    <option value="false" selected="@(Model.SelectedIsSuccess == false)">ناموفق</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                    <i class="bi bi-funnel-fill"></i> اعمال فیلتر
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="بازنشانی فیلترها">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Logs Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold d-flex align-items-center gap-2">
            <i class="bi bi-list-ul text-primary"></i> رکوردهای ثبت‌شده
            <span class="badge bg-secondary rounded-pill small font-monospace">@Model.TotalCount رکورد</span>
        </h6>
        <span class="text-muted small">صفحه @Model.CurrentPage از @Model.TotalPages</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="py-2 px-3" style="width: 50px;">#</th>
                    <th scope="col" class="py-2" style="width: 170px;">زمان و تاریخ</th>
                    <th scope="col" class="py-2" style="width: 140px;">کاربر</th>
                    <th scope="col" class="py-2" style="width: 160px;">نوع فعالیت</th>
                    <th scope="col" class="py-2" style="width: 110px;">دسته</th>
                    <th scope="col" class="py-2">شرح و جزئیات فعالیت</th>
                    <th scope="col" class="py-2" style="width: 130px;">آدرس IP</th>
                    <th scope="col" class="py-2 text-center" style="width: 80px;">جزئیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logs == null || Model.Logs.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            هیچ لاگ یا فعالیتی با معیارهای انتخابی یافت نشد.
                        </td>
                    </tr>
                }
                else
                {
                    int index = (Model.CurrentPage - 1) * Model.PageSize + 1;
                    foreach (var log in Model.Logs)
                    {
                        string badgeClass = log.LogLevel switch
                        {
                            "Error" => "badge bg-danger",
                            "Warning" => "badge bg-warning text-dark",
                            _ => log.IsSuccess ? "badge bg-success" : "badge bg-danger"
                        };

                        <tr>
                            <td class="px-3 text-muted small">@index</td>
                            <td class="font-monospace small text-muted" dir="ltr">
                                @log.Timestamp.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-person-circle text-secondary"></i>
                                    <span class="font-monospace fw-bold small">@log.Username</span>
                                </div>
                            </td>
                            <td>
                                <span class="@badgeClass small font-monospace d-inline-flex align-items-center gap-1">
                                    @if (!log.IsSuccess)
                                    {
                                        <i class="bi bi-x-circle-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle-fill"></i>
                                    }
                                    @log.Action
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border small font-monospace">@log.Category</span>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 380px;" title="@log.Details">
                                    <span class="small text-dark">@log.Details</span>
                                    @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                    {
                                        <div class="text-danger small font-monospace text-truncate" style="max-width: 380px;">
                                            <i class="bi bi-exclamation-circle me-1"></i> @log.ErrorMessage.Split('\n')[0]
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="font-monospace small text-muted" dir="ltr">
                                @(string.IsNullOrEmpty(log.IpAddress) ? "-" : log.IpAddress)
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-show-detail"
                                        data-action="@log.Action"
                                        data-user="@log.Username"
                                        data-time="@log.Timestamp.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")"
                                        data-details="@log.Details"
                                        data-error="@log.ErrorMessage"
                                        data-ip="@log.IpAddress">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 d-flex justify-content-center">
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-search="@Model.SearchQuery"
                           asp-route-username="@Model.SelectedUser"
                           asp-route-category="@Model.SelectedCategory"
                           asp-route-logLevel="@Model.SelectedLogLevel"
                           asp-route-isSuccess="@Model.SelectedIsSuccess">قبلی</a>
                    </li>

                    @for (int p = Math.Max(1, Model.CurrentPage - 3); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 3); p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@p"
                               asp-route-search="@Model.SearchQuery"
                               asp-route-username="@Model.SelectedUser"
                               asp-route-category="@Model.SelectedCategory"
                               asp-route-logLevel="@Model.SelectedLogLevel"
                               asp-route-isSuccess="@Model.SelectedIsSuccess">@p</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-search="@Model.SearchQuery"
                           asp-route-username="@Model.SelectedUser"
                           asp-route-category="@Model.SelectedCategory"
                           asp-route-logLevel="@Model.SelectedLogLevel"
                           asp-route-isSuccess="@Model.SelectedIsSuccess">بعدی</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Modal: Log Details -->
<div class="modal fade" id="logDetailModal" tabindex="-1" aria-labelledby="logDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold" id="logDetailModalLabel">
                    <i class="bi bi-info-circle text-primary"></i> جزئیات رویداد
                </h6>
                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <div class="small text-muted">عنوان رویداد:</div>
                        <div class="fw-bold font-monospace" id="modalLogAction"></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small text-muted">کاربر:</div>
                        <div class="fw-bold font-monospace" id="modalLogUser"></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small text-muted">زمان و تاریخ:</div>
                        <div class="font-monospace text-muted small" id="modalLogTime" dir="ltr"></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small text-muted">آدرس IP:</div>
                        <div class="font-monospace text-muted small" id="modalLogIp" dir="ltr"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted">شرح کامل فعالیت:</label>
                    <div class="p-3 bg-light rounded border font-monospace small" id="modalLogDetails" style="white-space: pre-wrap; word-break: break-all;"></div>
                </div>

                <div id="modalErrorContainer" class="d-none">
                    <label class="form-label small text-danger fw-bold">پیام خطا و جزئیات استثناء (StackTrace):</label>
                    <pre class="p-3 bg-dark text-danger rounded small font-monospace text-start" id="modalLogError" style="max-height: 250px; overflow-y: auto; direction: ltr; white-space: pre-wrap;"></pre>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Clear Old Logs (Admin only) -->
@if (User.IsInRole("Admin"))
{
    <div class="modal fade" id="clearLogsModal" tabindex="-1" aria-labelledby="clearLogsModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Clear" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h6 class="modal-title fw-bold text-danger" id="clearLogsModalLabel">
                            <i class="bi bi-trash3 text-danger"></i> پاک‌سازی لاگ‌های قدیمی
                        </h6>
                        <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="بستن"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-3">لاگ‌های قدیمی‌تر از بازه انتخابی برای آزادسازی فضا پاک خواهند شد.</p>
                        <div class="mb-3">
                            <label class="form-label small">بازه زمانی برای نگه‌داری:</label>
                            <select name="daysToKeep" class="form-select">
                                <option value="7">لاگ‌های قدیمی‌تر از ۷ روز حذف شوند</option>
                                <option value="30" selected>لاگ‌های قدیمی‌تر از ۳۰ روز حذف شوند</option>
                                <option value="90">لاگ‌های قدیمی‌تر از ۹۰ روز حذف شوند</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                        <button type="submit" class="btn btn-danger">تأیید و پاک‌سازی</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.btn-show-detail').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('modalLogAction').textContent = this.getAttribute('data-action');
                document.getElementById('modalLogUser').textContent = this.getAttribute('data-user');
                document.getElementById('modalLogTime').textContent = this.getAttribute('data-time');
                document.getElementById('modalLogIp').textContent = this.getAttribute('data-ip') || '-';
                document.getElementById('modalLogDetails').textContent = this.getAttribute('data-details');

                const error = this.getAttribute('data-error');
                const errorContainer = document.getElementById('modalErrorContainer');
                const errorPre = document.getElementById('modalLogError');
                if (error && error.trim() !== '') {
                    errorPre.textContent = error;
                    errorContainer.classList.remove('d-none');
                } else {
                    errorContainer.classList.add('d-none');
                    errorPre.textContent = '';
                }

                new bootstrap.Modal(document.getElementById('logDetailModal')).show();
            });
        });
    </script>
}
